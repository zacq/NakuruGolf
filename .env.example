# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Long random strings, e.g. openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=
# Staff dashboard password
ADMIN_PASSWORD=

# Public site URL (defaults to the Netlify site URL)
NEXT_PUBLIC_SITE_URL=

# true = simulated M-Pesa payments and on-screen login codes. Staging only, never on the live site.
DEMO_MODE=false

# M-Pesa (Safaricom Daraja). MPESA_ENV is sandbox or production.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Long random hex string
MPESA_CALLBACK_SECRET=
# https://<site>/api/mpesa/callback
MPESA_CALLBACK_URL=
# Shown to guests as the manual fallback
NEXT_PUBLIC_MPESA_PAYBILL=

# SMS (Africa's Talking) and email (Resend)
AT_USERNAME=
AT_API_KEY=
RESEND_API_KEY=
EMAIL_FROM="Nakuru Golf Club <bookings@nakurugolfclub.co.ke>"

# Analytics and social links (optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
